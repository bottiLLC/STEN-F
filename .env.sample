# ==============================================================================
# STEN-F 環境設定ファイル (.env.sample)
# ==============================================================================

# データベース接続設定（SQLite + aiosqlite）
# ※ 未設定の場合はデフォルトで data/sten_f.db が使用されます。
DATABASE_URL=sqlite+aiosqlite:///data/sten_f.db

# --- AI連携設定 (Google Gemini API) ---
# Gemini API Key (AI OCR によるレシート・領収書読取および勘定科目推論に利用)
# Google AI Studio (https://aistudio.google.com/) で取得したAPIキーを設定します。
# ※ 画面の「マスタ・システム管理」→「AI・システム設定」タブから登録・保存することも可能です。
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini モデル設定 (Google公式最新モデルコード)
# デフォルト: gemini-3.5-flash-lite (高速・低コスト)
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite

# --- アプリケーション設定 (任意) ---
# APP_TITLE=STEN-F
# CURRENCY_SYMBOL=¥
