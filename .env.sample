# Database Configuration
# Default: sqlite+aiosqlite:///./data/sten_f.db
# To use the migrated Dencho-compliant DB, set to:
DATABASE_URL=sqlite+aiosqlite:///bookkeeping.db


# Google Cloud API Key (Required for Gemini/Vision API if used directly, though we use Vertex via OpenAI SDK pattern primarily or Google GenAI SDK)
# If using Google GenAI SDK:
GOOGLE_API_KEY=your_google_api_key_here

# Application Settings (Optional)
# APP_TITLE=STEN-F
# CURRENCY_SYMBOL=¥
