# ==============================================================================
# STEN-F 環境設定ファイル (.env.sample)
# ==============================================================================
# このファイルをコピーして「.env」ファイルを作成し、必要に応じて設定値を記述してください。
# ※ Windowsコマンド例: copy .env.sample .env
# ※ Mac/Linuxコマンド例: cp .env.sample .env

# --- データベース設定 ---
# データベース接続URL（SQLite + aiosqlite）
# 未設定の場合はデフォルトで「data/sten_f.db」が自動生成・使用されます。
DATABASE_URL=sqlite+aiosqlite:///data/sten_f.db

# --- AI連携設定 (Google Gemini API) ---
# Gemini API キー (証憑 AI OCR 読取および勘定科目推論に使用)
# Google AI Studio (https://aistudio.google.com/) で取得したAPIキーを設定してください。
# ※ 画面左メニュー「設定・管理」→「マスタ・システム管理」→「⚙️ AI・システム設定」タブから登録・保存することも可能です。
GEMINI_API_KEY=your_gemini_api_key_here

# 使用する Gemini AI モデルコード（Google公式最新モデル）
# デフォルト: gemini-3.5-flash-lite (超高速・高精度・低コスト)
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite

# --- アプリケーション設定 (任意・デフォルト値あり) ---
APP_TITLE=STEN-F
CURRENCY_SYMBOL=¥
