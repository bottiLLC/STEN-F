# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///bookkeeping.db

# --- API Keys for AI Features ---
# 1. Google Gemini API Key (Required for AI-OCR parsing of form data via Google GenAI SDK)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenAI API Key (Required for intelligent assistants via Responses API v2.3)
OPENAI_API_KEY=your_openai_api_key_here

# --- Application Settings (Optional) ---
# APP_TITLE=STEN-F
# CURRENCY_SYMBOL=¥

# --- OpenAI API Settings (Optional) ---
# OPENAI_DEFAULT_MODEL=GPT-5.6-Luna
# OPENAI_REASONING_EFFORT=medium
