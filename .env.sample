# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///bookkeeping.db

# --- API Keys for AI Features ---
# OpenAI API Key (Required for intelligent assistants and OCR parsing)
OPENAI_API_KEY=your_openai_api_key_here

# --- Application Settings (Optional) ---
# APP_TITLE=STEN-F
# CURRENCY_SYMBOL=¥

# --- OpenAI API Settings (Optional) ---
# 最新の GPT-5.6 世代のモデルおよび推論深度（Reasoning Effort）を指定できます。
# モデル例: gpt-5.6-terra (標準推論), gpt-5.6-sol (最高精度), gpt-5.6-luna (高速/低コスト)
# OPENAI_DEFAULT_MODEL=gpt-5.6-terra
# 推論深度 (Reasoning Effort): low, medium, high, xhigh
# OPENAI_REASONING_EFFORT=high
